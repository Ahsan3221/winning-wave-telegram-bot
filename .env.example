# Never commit a real .env file or BOT_TOKEN.
# These are loaded by Railway Variables, not a local .env file.

# ============================================================
# REQUIRED — bot will not start without these
# ============================================================

BOT_TOKEN=123456789:replace_with_the_token_for_winning_wave_bot_only
SUPPORT_GROUP_ID=-1003960273507
DATABASE_URL=postgresql://user:password@host:5432/database
AUTHORIZED_STAFF_IDS=5991692961

# ============================================================
# OPTIONAL — ad optimization tuning (all have safe defaults)
# ============================================================

# Auto-nudge: if user starts bot but doesn't message within N seconds, send a nudge
NUDGE_ENABLED=true
NUDGE_DELAY_SECONDS=90

# Anti-fraud: flag users who press /start >= N times within M seconds
SUSPICIOUS_START_THRESHOLD=3
SUSPICIOUS_START_WINDOW=60

# Optional health endpoint (for Railway uptime checks). 0 = disabled.
# Set to 8080 to enable GET /health returning JSON status.
HEALTH_PORT=0

# Optional: override the games list (comma-separated). Defaults to all 9.
# ALLOWED_GAMES=Orionstars,Firekirin,Ultrapanda,Juwa
